{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|terminal|Write|write_file|Edit|file_editor|planning_file_editor|apply_patch|edit|MultiEdit|NotebookEdit|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @pushary/agent-hooks@latest pushary-hook --agent=openhands --event=PreToolUse",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|terminal|Write|write_file|Edit|file_editor|planning_file_editor|apply_patch|edit|MultiEdit|NotebookEdit|PowerShell|Monitor|TodoWrite|Task|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @pushary/agent-hooks@latest pushary-post-hook --agent=openhands --event=PostToolUse",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @pushary/agent-hooks@latest pushary-stop-hook --agent=openhands --event=Stop",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @pushary/agent-hooks@latest pushary-prompt-hook --agent=openhands --event=UserPromptSubmit",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @pushary/agent-hooks@latest pushary-session-start-hook --agent=openhands --event=SessionStart",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y -p @pushary/agent-hooks@latest pushary-session-end-hook --agent=openhands --event=SessionEnd",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
